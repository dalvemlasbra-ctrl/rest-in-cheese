    <script>
        const HUB_LAT = -6.115;
        const HUB_LNG = 106.772;
        let map, hubMarker, destMarker, routeLine;
        let selectedDist = 0;
        let selectedCost = 0;
        let destName = "Belum Diatur";
        let cart = { bundle: 0, pumpkin: 0, corn: 0, banana: 0 };
        const prices = { bundle: 189000, pumpkin: 70000, corn: 65000, banana: 65000 };
        window.onload = function() {
            initMap();
        };
        function initMap() {
            map = L.map('map', { zoomControl: false }).setView([HUB_LAT, HUB_LNG], 12);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);
            let hubIcon = L.divIcon({
                html: '🧀',
                className: 'text-3xl flex items-center justify-center',
                iconSize: [30, 30]
            });
            hubMarker = L.marker([HUB_LAT, HUB_LNG], { icon: hubIcon }).addTo(map)
                .bindPopup('<b>Rest in Cheese Hub</b><br>Taman Grisenda').openPopup();
        }
        function toggleDrawer() {
            let drawer = document.getElementById('drawer');
            let backdrop = document.getElementById('backdrop');
            drawer.classList.toggle('-translate-x-full');
            backdrop.classList.toggle('hidden');
        }
        function toggleGiftField() {
            let isGift = document.getElementById('gift-toggle').checked;
            document.getElementById('gift-note').classList.toggle('hidden', !isGift);
        }
        function addBundle() {
            cart.bundle += 1;
            updateCart();
        }
        function updateQty(item, change) {
            cart[item] = Math.max(0, cart[item] + change);
            updateCart();
        }
        function updateCart() {
            document.getElementById('qty-pumpkin').innerText = cart.pumpkin;
            document.getElementById('qty-corn').innerText = cart.corn;
            document.getElementById('qty-banana').innerText = cart.banana;
            let totalItems = cart.bundle + cart.pumpkin + cart.corn + cart.banana;
            document.getElementById('item-count-badge').innerText = totalItems + " Item";
            let subtotal = (cart.bundle * prices.bundle) +
                           (cart.pumpkin * prices.pumpkin) +
                           (cart.corn * prices.corn) +
                           (cart.banana * prices.banana);
            let listHtml = '';
            if (cart.bundle > 0) listHtml += `<div class="flex justify-between"><span>The Ultimate Trio Bundle x${cart.bundle}</span><span class="font-bold">Rp ${(cart.bundle * prices.bundle).toLocaleString('id-ID')}</span></div>`;
            if (cart.pumpkin > 0) listHtml += `<div class="flex justify-between"><span>Pumpkin & Vanilla Bean x${cart.pumpkin}</span><span class="font-bold">Rp ${(cart.pumpkin * prices.pumpkin).toLocaleString('id-ID')}</span></div>`;
            if (cart.corn > 0) listHtml += `<div class="flex justify-between"><span>Corn & Coconut x${cart.corn}</span><span class="font-bold">Rp ${(cart.corn * prices.corn).toLocaleString('id-ID')}</span></div>`;
            if (cart.banana > 0) listHtml += `<div class="flex justify-between"><span>Roasted Banana & Honey x${cart.banana}</span><span class="font-bold">Rp ${(cart.banana * prices.banana).toLocaleString('id-ID')}</span></div>`;
            if (totalItems === 0) listHtml = '<p class="text-stone-400 italic">Belum ada item dipilih.</p>';
            document.getElementById('cart-summary-list').innerHTML = listHtml;
            document.getElementById('subtotal-val').innerText = 'Rp ' + subtotal.toLocaleString('id-ID');
            document.getElementById('shipping-fee-val').innerText = 'Rp ' + selectedCost.toLocaleString('id-ID');
            document.getElementById('grand-total-val').innerText = 'Rp ' + (subtotal + selectedCost).toLocaleString('id-ID');
        }
        function calculateHaversine(lat1, lon1, lat2, lon2) {
            const R = 6371;
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                      Math.sin(dLon/2) * Math.sin(dLon/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
            return R * c * 1.25;
        }
        async function searchAddress() {
            let query = document.getElementById('address-input').value;
            if (!query) return;
            let url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query + ', Jakarta, Indonesia')}`;
            
            try {
                let res = await fetch(url);
                let data = await res.json();
                if (data && data.length > 0) {
                    let destLat = parseFloat(data[0].lat);
                    let destLng = parseFloat(data[0].lon);
                    destName = data[0].display_name.split(',')[0];
                    updateRoute(destLat, destLng, destName);
                } else {
                    alert("Alamat tidak ditemukan. Coba ketik nama jalan, mall, atau area utama.");
                }
            } catch (e) {
                alert("Gagal koneksi server peta. Coba beberapa saat lagi.");
            }
        }
        function updateRoute(lat, lng, name) {
            if (destMarker) map.removeLayer(destMarker);
            if (routeLine) map.removeLayer(routeLine);
            destMarker = L.marker([lat, lng]).addTo(map).bindPopup(`<b>${name}</b>`).openPopup();
            routeLine = L.polyline([[HUB_LAT, HUB_LNG], [lat, lng]], { color: '#f59e0b', weight: 4, dashArray: '6, 8' }).addTo(map);
            let group = L.featureGroup([hubMarker, destMarker]);
            map.fitBounds(group.getBounds().pad(0.2));
            let km = calculateHaversine(HUB_LAT, HUB_LNG, lat, lng);
            selectedDist = km;
            selectedCost = km <= 4 ? 10000 : Math.round(10000 + ((km - 4) * 2500));
            document.getElementById('dist-val').innerText = km.toFixed(1) + " km";
            document.getElementById('cost-val').innerText = "Rp " + selectedCost.toLocaleString('id-ID');
            document.getElementById('time-val').innerText = "~" + Math.round(km * 3) + " Min";
            updateCart();
        }
        function checkoutWA() {
            let totalItems = cart.bundle + cart.pumpkin + cart.corn + cart.banana;
            if (totalItems === 0) {
                alert("Pilih minimal 1 jar cheesecake terlebih dahulu! 🧀");
                return;
            }
            let text = `Halo Rest in Cheese! Saya mau pesan cheesecake via web katalog:\n\n`;
            if (cart.bundle > 0) text += `- The Ultimate Trio Bundle (Rp 189k) x${cart.bundle}\n`;
            if (cart.pumpkin > 0) text += `- Pumpkin & Vanilla Bean (Rp 70k) x${cart.pumpkin}\n`;
            if (cart.corn > 0) text += `- Corn & Coconut (Rp 65k) x${cart.corn}\n`;
            if (cart.banana > 0) text += `- Roasted Banana & Honey (Rp 65k) x${cart.banana}\n`;
            if (document.getElementById('gift-toggle').checked) {
                let note = document.getElementById('gift-note').value;
                text += `\n🎁 Note Kartu Ucapan: "${note || 'Happy Birthday!'}"\n`;
            }
            let subtotal = (cart.bundle * prices.bundle) + (cart.pumpkin * prices.pumpkin) + (cart.corn * prices.corn) + (cart.banana * prices.banana);
            text += `\nAlamat Tujuan: ${destName}\n`;
            text += `Est. Jarak: ${selectedDist.toFixed(1)} km\n`;
